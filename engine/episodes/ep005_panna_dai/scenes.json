 "hook": {
  "text": "SHE SACRIFICED\nHER OWN SON",
  "until": 3.0,
  "y": 0.6,
  "size": 122,
  "accent": [
   "SON"
  ]
 },
 "lines": [
  {
   "text": "She saved a prince... by giving up her own son.",
   "emph": [
    "son"
   ]
  },
  {
   "text": "Chittor, fifteen thirty-six. Banvir has seized Mewar, and killed its ruler.",
   "caption": "Chittor, 1536. Banvir has seized Mewar, and killed its ruler.",
   "emph": [
    "1536",
    "banvir"
   ]
  },
  {
   "text": "Now he wants the young heir, Udai Singh, dead.",
   "emph": [
    "udai",
    "singh",
    "dead."
   ]
  },
  {
   "text": "Tradition says the prince's nurse, Panna Dhaai, heard the cries from the palace.",
   "caption": "Tradition says the prince's nurse, Panna Dai, heard the cries from the palace.",
   "emph": [
    "panna",
    "dai,"
   ]
  },
  {
   "text": "She hid Udai in a fruit basket, and a trusted servant carried him out of the fort.",
   "emph": [
    "basket,"
   ]
  },
  {
   "text": "But Panna stayed behind.",
   "emph": [
    "stayed"
   ]
  },
  {
   "text": "She laid her own son... in the prince's bed.",
   "emph": [
    "own",
    "son..."
   ]
  },
  {
   "text": "Banvir burst in, sword drawn, and demanded the prince. Panna could not speak. She pointed to the bed.",
   "emph": [
    "pointed"
   ]
  },
  {
   "text": "Her son died in the prince's place.",
   "emph": [
    "died"
   ]
  },
  {
   "text": "Panna reached Kumbhalgarh with Udai, and he was hidden there for years.",
   "emph": [
    "kumbhalgarh"
   ]
  },
  {
   "text": "In fifteen forty, Udai Singh took back Mewar. Years later, he founded Udaipur, the City of Lakes.",
   "caption": "In 1540, Udai Singh took back Mewar. Years later, he founded Udaipur, the City of Lakes.",
   "emph": [
    "1540,",
    "udaipur,"
   ]
  },
  {
   "text": "A kingdom lived on... because one mother chose duty over her own child.",
   "emph": [
    "duty"
   ]
  }
 ],
