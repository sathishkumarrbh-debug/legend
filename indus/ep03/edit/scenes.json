 "lines": [
  {
   "text": "In nineteen ninety-one, archaeologists in Gujarat found something strange in the dirt.",
   "caption": "In 1991, archaeologists in Gujarat found something strange in the dirt.",
   "emph": [
    "strange"
   ]
  },
  {
   "text": "Ten huge signs. Each one bigger than a school ruler.",
   "caption": "10 huge signs. Each one bigger than a school ruler.",
   "emph": [
    "10",
    "ruler."
   ]
  },
  {
   "text": "Four thousand years ago, they were fixed on a wooden board... at the gate of a city called Dholavira.",
   "caption": "4,000 years ago, they were fixed on a wooden board... at the gate of a city called Dholavira.",
   "emph": [
    "4,000",
    "dholavira."
   ]
  },
  {
   "text": "Then the board fell face down. The wood rotted away... but the signs stayed in the ground, in order.",
   "emph": [
    "fell",
    "order."
   ]
  },
  {
   "text": "It may be the oldest signboard ever found.",
   "emph": [
    "oldest"
   ]
  },
  {
   "text": "So... what did it say?",
   "emph": [
    "say?"
   ]
  },
  {
   "text": "Nobody knows.",
   "emph": []
  },
  {
   "text": "We have found more than four thousand pieces of Indus writing. But most are only four or five signs long.",
   "caption": "We have found more than 4,000 pieces of Indus writing. But most are only 4 or 5 signs long.",
   "emph": [
    "4,000",
    "5"
   ]
  },
  {
   "text": "And there's no translation key, like Egypt's Rosetta Stone.",
   "emph": [
    "rosetta"
   ]
  },
  {
   "text": "We don't even know what language they spoke.",
   "emph": [
    "language"
   ]
  },
  {
   "text": "That's why there's now a one-million-dollar prize for anyone who can read it.",
   "caption": "That's why there's now a $1,000,000 prize for anyone who can read it.",
   "emph": [
    "$1,000,000"
   ]
  },
  {
   "text": "Ten signs at the gate of a great city... and no one alive can read them.",
   "caption": "10 signs at the gate of a great city... and no one alive can read them.",
   "emph": [
    "no",
    "one"
   ]
  }
 ],
