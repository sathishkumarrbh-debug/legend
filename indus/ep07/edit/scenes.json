 "hook": {
  "text": "4,000 YEARS OLD.\nSTILL HAS ATTITUDE.",
  "until": 2.6,
  "y": 0.1,
  "size": 115,
  "accent": [
   "ATTITUDE."
  ]
 },
 "lines": [
  {
   "text": "She's four thousand years old... and smaller than your hand.",
   "emph": [
    "hand."
   ],
   "caption": "She's 4,000 years old... and smaller than your hand."
  },
  {
   "text": "Archaeologist Ernest Mackay found her at Mohenjo-daro, in nineteen twenty-six.",
   "emph": [
    "1926."
   ],
   "caption": "Archaeologist Ernest Mackay found her at Mohenjo-daro, in 1926."
  },
  {
   "text": "Look at her. Hand on her hip. Chin up.",
   "emph": [
    "hip."
   ]
  },
  {
   "text": "And bangles... almost all the way to her shoulder. Twenty-four on one arm.",
   "emph": [
    "24"
   ],
   "caption": "And bangles... almost all the way to her shoulder. 24 on one arm."
  },
  {
   "text": "She isn't carved. She was cast in bronze, with a trick called lost-wax.",
   "emph": [
    "lost-wax."
   ]
  },
  {
   "text": "Shape her in wax. Coat her in clay. Heat it... and the wax runs out.",
   "emph": [
    "runs"
   ]
  },
  {
   "text": "Pour in molten metal. Then break the mould... and she's born.",
   "emph": [
    "born."
   ]
  },
  {
   "text": "One mould, one statue. There's no other like her.",
   "emph": [
    "other"
   ]
  },
  {
   "text": "Archaeologist Mortimer Wheeler said she was perfectly confident of herself and the world.",
   "emph": [
    "confident"
   ]
  },
  {
   "text": "But we call her a dancer... and no one knows if she ever danced.",
   "emph": [
    "danced."
   ]
  },
  {
   "text": "And that lost-wax trick? Craftsmen in India still use it today.",
   "emph": [
    "today."
   ]
  },
  {
   "text": "But to trade metal like this, you have to weigh it... and their weights were frighteningly exact.",
   "emph": [
    "exact."
   ]
  }
 ],
